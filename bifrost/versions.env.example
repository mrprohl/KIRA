# Image versions for Bifrost – template; /opt/kira/setup.sh copies it to env/versions.env
# To change: edit env/versions.env, then redeploy the stack ("Re-pull image")
# Bifrost pinned: updates migrate the database – read the changelog first (docs.getbifrost.ai/changelogs)
BIFROST_TAG=v2.6.0
# NOT latest: major version pinned – a change needs a data migration (pg_dump/pg_restore)
POSTGRES_TAG=18-alpine
