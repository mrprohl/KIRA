# Code interpreter – versions (copied to env/versions.env by setup.sh; change here, then run bash /opt/kira/setup.sh)
# Tagged release of ClickHouse/code-interpreter (https://github.com/ClickHouse/code-interpreter/releases).
# setup.sh clones it into src/ and builds the images (first build 30 minutes or more).
CODEAPI_VERSION=v1.9.1
# Commit of that release – setup.sh refuses sources with another commit (a moved tag). Change both together;
# the commit of a release: git ls-remote https://github.com/ClickHouse/code-interpreter refs/tags/v1.x.y^{}
CODEAPI_COMMIT=829992a4d837da67737edcdc3c5b57eaaa5c3b3d
# Images of the helper services (empty = defaults of the project: redis:7-alpine, quay.io/minio/minio)
REDIS_IMAGE=
MINIO_IMAGE=
