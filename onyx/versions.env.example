# Image versions for Onyx – template; /opt/kira/setup.sh copies it to env/versions.env
# To change: edit env/versions.env, then redeploy the stack ("Re-pull image"). Back up first.
# Onyx: all three Onyx images (backend, web-server, model-server) use the same tag – github.com/onyx-dot-app/onyx/releases
ONYX_TAG=v5.1.3
# helper services as in the official docker-compose.yml of Onyx v5.1.3
ONYX_POSTGRES_TAG=15.2-alpine
OPENSEARCH_TAG=3.6.0
ONYX_REDIS_TAG=7.4-alpine
ONYX_NGINX_TAG=1.25.5-alpine
