# Image versions for the web search – template; /opt/kira/setup.sh copies it to env/versions.env
# To change: edit env/versions.env, then redeploy the stack ("Re-pull image")
# SearXNG: date tags (e.g. 2026.11.15-abc1234) – latest = newest version
SEARXNG_TAG=latest
# Firecrawl API: version tags such as 2.11.813 (also 2.11 = newest 2.11.x) – github.com/firecrawl/firecrawl
FIRECRAWL_TAG=2.11.813
# Firecrawl's Playwright service and queue Postgres only exist as latest or sha-<commit>
FIRECRAWL_PLAYWRIGHT_TAG=latest
FIRECRAWL_NUQ_TAG=latest
# Firecrawl helper services (caches only, no data)
REDIS_TAG=7.4-alpine
# RabbitMQ without the management web interface (Firecrawl only uses AMQP)
RABBITMQ_TAG=3-alpine
