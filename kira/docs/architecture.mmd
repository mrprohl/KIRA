%% Source of docs/architecture.png – render: mmdc -i architecture.mmd -o architecture.png -b white -w 3600 -s 3 -c <config with "layout":"elk">
flowchart LR
  U([<b>Browser / PWA</b><br/>users]) -->|HTTPS| C
  EXT([<b>External applications</b><br/>own virtual key]) -->|HTTPS, allowed IPs only| C

  subgraph caddy["/opt/caddy"]
    C[<b>Caddy</b><br/>TLS, reverse proxy<br/>only published ports]
  end

  subgraph kira["/opt/kira"]
    LC[<b>LibreChat</b><br/>web interface, agents]
    MO[(<b>MongoDB</b><br/>chats, users)]
    ME[<b>Meilisearch</b><br/>chat search]
    RAG[<b>RAG API</b><br/>documents]
    VDB[(<b>pgvector</b><br/>embeddings)]
  end

  subgraph bifrost["/opt/bifrost"]
    BF[<b>Bifrost</b><br/>LLM gateway<br/>keys, budgets]
    BDB[(<b>PostgreSQL</b><br/>config, logs)]
  end

  subgraph websearch["/opt/websearch"]
    SX[<b>SearXNG</b><br/>result list]
    FC[<b>Firecrawl</b><br/>reads pages]
  end

  subgraph onyx["/opt/onyx (optional)"]
    OX[<b>Onyx</b><br/>intranet index, MCP]
  end

  subgraph gpu["GPU servers in the LAN (optional)"]
    VL[<b>vLLM</b><br/>privacy and safety checker,<br/>local answers, embeddings]
  end

  C --> LC
  C -->|LLM API, admin UI| BF
  C -->|admin UI| OX
  LC --> MO & ME & RAG
  RAG --> VDB
  LC -->|chat, images, speech| BF
  RAG -->|embeddings| BF
  LC -->|web search| SX & FC
  LC -->|MCP: agent Intranet| OX
  OX -->|LLM| BF
  BF --> BDB
  LC -.->|OIDC login| KC([<b>Keycloak</b><br/>→ Microsoft 365])
  BF ==>|internet| AI([<b>Anthropic, OpenAI</b>])
  SX & FC ==>|internet| WEB([<b>Search engines,<br/>web pages</b>])
  OX ==>|internet| SP([<b>SharePoint / Graph</b>])
  BF -.->|privacy guard| VL

