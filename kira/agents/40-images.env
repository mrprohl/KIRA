# ============================================================================
# Image agent – creates images (OpenAI image model via Bifrost)
# Special case: in LibreChat the image tool only exists for "real" agents. So create this agent ONCE in the
# web interface (README, section "Image agent") and enter its ID below at AGENT_ID.
# Without AGENT_ID or with IMAGE_GENERATION=false in env/setup.env it is not shown.
# The text in 40-images.md is the instruction you paste into the "Instructions" field when creating it.
# ============================================================================
NAME=images
TITLE="Bilder"
DESCRIPTION="Erstellt Bilder und Grafiken nach Beschreibung"
AGENT_ID=
ICON=40-images.svg
DEFAULT=false
IMAGES=true
ENABLED=true
