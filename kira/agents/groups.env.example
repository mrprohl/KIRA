# ============================================================================
# Agents per Keycloak group – only effective with AGENT_GROUPS=true in /opt/kira/env/setup.env
#
#   <group>=<agents, comma-separated>
#     group   = name of the Keycloak group as it appears in the "groups" claim of the ID token
#               (mapper "Group Membership", "Full group path" OFF)
#     agents  = NAME from the agent files (kira, code, intranet, images, writing, minutes)
#   ADMIN_GROUP  = Keycloak group of the admins (sees all agents)
#
# Users without one of these groups in the token cannot log in and see no agent.
# New accounts automatically in kira-users-default: in Keycloak Realm settings → User registration → Default groups.
#
# Admins = members of ADMIN_GROUP: they always see all agents – their group is only listed at ADMIN_GROUP.
# Users in several groups get the group with the most agents (tie: order in this file).
# To change: edit this file, then bash /opt/kira/setup.sh (or /opt/kira/scripts/agent-groups.sh).
# Template: agents/groups.env.example – setup.sh creates groups.env from it once; a new package does not overwrite it.
# ============================================================================
ADMIN_GROUP=kira-admins

kira-users-it=kira,code,writing,minutes,images
kira-users-default=kira,intranet,writing,minutes,images
kira-users-custom=kira,writing,minutes

# ----------------------------------------------------------------------------
# Own agents (agent builder) – optional; remove BUILDER_GROUP and the builder.… lines if nobody should build agents
#   BUILDER_GROUP=<group>            may build own agents: yes (member) / no
#   builder.<model group>=<models>   which models a member may use – Bifrost model IDs, comma-separated,
#                                    e.g. anthropic/claude-haiku-5-5, openai/gpt-6.1-terra; must be allowed for the
#                                    key vk-librechat in Bifrost (setup.sh checks this against bifrost.json)
#   Builder = member of BUILDER_GROUP AND of at least one model group (in addition to the agent group above).
#   Several model groups add up. Admins (ADMIN_GROUP) build without these groups, with all models.
#   Needs a Keycloak service account (setup.sh asks for it, README section "Own agents"); members are
#   synchronised every 5 minutes. Own agents are private (no sharing); the fixed agents stay as above.
#   In the builder the "Anbieter" is the provider (Anthropic, OpenAI, …); below it the user's models.
#   The tiers do not overlap: whoever should also use cheaper models gets the other model groups too.
# ----------------------------------------------------------------------------
BUILDER_GROUP=kira-builder
builder.kira-model-default=anthropic/claude-haiku-5-5,openai/gpt-6-luna,openai/gpt-6.1-terra
builder.kira-model-plus=anthropic/claude-sonnet-5-5,openai/gpt-6.1-sol
builder.kira-model-premium=anthropic/claude-opus-5-5,openai/gpt-6-astra
