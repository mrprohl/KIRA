MODEL=openai/gpt-6.1-terra
ICON=30-intranet.svg
TEMPERATURE=0.2
DEFAULT=false
WEB_SEARCH=false
FILE_SEARCH=false
INTRANET=true
IMAGES=false
DOCS=true
TEMPLATES=false
CONFIDENTIAL=false
CODE=false
ENABLED=true
