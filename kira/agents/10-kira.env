# ============================================================================
# Agent KIRA – default assistant for everything (shown as first choice)
# Fields: see agents/README.md. After changes: bash /opt/kira/setup.sh (regenerates config/librechat.yaml)
# and restart LibreChat (setup.sh offers to do so).
# ============================================================================
NAME=kira
TITLE="KIRA"
DESCRIPTION="Allround-Assistent für Fragen, Texte und Recherche im Internet"
MODEL=anthropic/claude-sonnet-5-5
TEMPERATURE=0.5
DEFAULT=true
WEB_SEARCH=true
FILE_SEARCH=true
INTRANET=false
IMAGES=false
ENABLED=true
