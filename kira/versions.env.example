# Image versions for KIRA (LibreChat) – template; setup.sh copies it to env/versions.env
# To change: edit env/versions.env, then redeploy the stack ("Re-pull image"). Back up first (scripts/backup.sh).
# LibreChat – releases: github.com/danny-avila/LibreChat/releases. Official registry (as in LibreChat's Helm chart);
# if unreachable, fall back to ghcr.io/librechat-ai/librechat (same image)
LIBRECHAT_IMAGE=registry.librechat.ai/librechat-ai/librechat
LIBRECHAT_TAG=v0.8.9
# RAG API (document search) – releases: github.com/danny-avila/rag_api; fallback: ghcr.io/librechat-ai/librechat-rag-api-dev-lite
RAG_API_IMAGE=registry.librechat.ai/librechat-ai/librechat-rag-api-dev-lite
RAG_API_TAG=v0.9.1
# MongoDB: major version pinned (change only with mongodump/mongorestore); needs a CPU with AVX
MONGO_TAG=8.0.20
# Meilisearch: version pinned – a change needs a rebuild of the search index (delete the volume, LibreChat reindexes)
MEILI_TAG=v1.35.1
# pgvector (PostgreSQL 15) for the RAG API – as in the official LibreChat package
PGVECTOR_TAG=0.8.0-pg15-trixie
