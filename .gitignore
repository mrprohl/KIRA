# KIRA – never commit secrets or files generated on the server
# (the repository contains the package as extracted to /opt, without env/ and generated config)

# secrets (API keys, passwords, client secrets) – every stack
env/
*/env/
**/env/*.env
*.env
!*.env.example
!kira/agents/*.env
!kira/agents/groups.env.example

# generated by setup.sh / the scripts on the server
kira/config/
kira/agents/groups.env
caddy/config/Caddyfile
caddy/config/sites/
bifrost/config/bifrost.json
*/env/versions.env
*.state.json

# backups, logs, local leftovers
*.tgz
*.archive.gz
*.sql.gz
*.log
__pycache__/
*.pyc
.DS_Store
Thumbs.db
