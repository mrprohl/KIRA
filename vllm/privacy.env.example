# Privacy checker – server "privacy" (1× A100), together with embedding.env on the same GPU
STACK_NAME=kira-privacy
SERVED_NAME=kira-privacy
# FP8: weights about 35 GB, fits on one 80 GB GPU together with the embedding model; BF16 (about 70 GB) does not.
# A100 has no native FP8 – vLLM runs it weight-only (works, a bit slower). GPU with 24 GB: a 4-bit (GPTQ/AWQ) variant.
MODEL=Qwen/Qwen3.5-35B-A3B-FP8
PORT=8101
GPU_DEVICES=0
TP_SIZE=1
# the GPU is shared with the embedding model (embedding.env: 0.12)
GPU_MEM=0.78
MAX_MODEL_LEN=32768
# images in requests are checked too (Qwen3.5 is multimodal); if requests with several images fail, raise the
# image limit per request (option --limit-mm-per-prompt, syntax depends on the vLLM version – vllm serve --help)
EXTRA_ARGS=
# vLLM image version – pin it (https://hub.docker.com/r/vllm/vllm-openai/tags); new models need a current vLLM
VLLM_TAG=
# the same key as VLLM_API_KEY in /opt/bifrost/env/bifrost.env on the KIRA server
VLLM_API_KEY=
# only for gated models on Hugging Face (empty = none)
HF_TOKEN=
# where the model files are kept (host path)
MODEL_CACHE=/opt/vllm/cache
# address the port is published on (0.0.0.0 = all; better: the LAN address of this server)
BIND_IP=0.0.0.0
