# Embeddings for the document search – server "embedding" (own server; a small GPU is enough)
STACK_NAME=kira-embedding
SERVED_NAME=kira-embedding
# 0.6B: about 1.2 GB (GPU from 8 GB). Better search results: Qwen/Qwen3-Embedding-8B (about 16 GB, GPU from 24 GB).
# Changing the model later: documents uploaded before have to be uploaded again.
MODEL=Qwen/Qwen3-Embedding-0.6B
PORT=8104
GPU_DEVICES=0
TP_SIZE=1
GPU_MEM=0.90
MAX_MODEL_LEN=8192
# embedding model (pooling); older vLLM versions use "--task embed" instead – see vllm serve --help
EXTRA_ARGS=--runner pooling
# vLLM image version – pin it (https://hub.docker.com/r/vllm/vllm-openai/tags); new models need a current vLLM
VLLM_TAG=
# the same key as VLLM_API_KEY in /opt/bifrost/env/bifrost.env on the KIRA server
VLLM_API_KEY=
# only for gated models on Hugging Face (empty = none)
HF_TOKEN=
# where the model files are kept (host path)
MODEL_CACHE=/opt/vllm/cache
# address the port is published on (0.0.0.0 = all; better: the LAN address of this server)
BIND_IP=0.0.0.0
