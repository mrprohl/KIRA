# Local answer model – server "answer"
# Qwen3.8-Flash-Next: new architecture (qwen4_exp) – needs a current vLLM; weights about 173 GiB in FP8, 335 GiB in
# BF16; tensor parallelism over the GPUs of the server (GPU_DEVICES/TP_SIZE – set both to match it), no pipeline
# parallelism; licence: Qwen Community License (read it). Fallback: MODEL=Qwen/Qwen3.8-27B with a smaller TP_SIZE.
STACK_NAME=kira-answer
SERVED_NAME=kira-answer
MODEL=Qwen/Qwen3.8-Flash-Next-FP8
PORT=8104
GPU_DEVICES=0,1,2,3
TP_SIZE=4
GPU_MEM=0.90
MAX_MODEL_LEN=131072
# tool calls (agents use tools: document search, intranet) – the parser name is on the model card
EXTRA_ARGS=--enable-auto-tool-choice --tool-call-parser hermes
# vLLM image version – pin it (https://hub.docker.com/r/vllm/vllm-openai/tags); new models need a current vLLM
VLLM_TAG=
# the same key as VLLM_API_KEY in /opt/bifrost/env/bifrost.env on the KIRA server
VLLM_API_KEY=
# only for gated models on Hugging Face (empty = none)
HF_TOKEN=
# where the model files are kept (host path)
MODEL_CACHE=/opt/vllm/cache
# address the port is published on (0.0.0.0 = all; better: the LAN address of this server)
BIND_IP=0.0.0.0
