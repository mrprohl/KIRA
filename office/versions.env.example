# ============================================================================
# Versions of the office stack – copied to /opt/office/env/versions.env by setup.sh (then edit there)
# ============================================================================
# Office MCP server (https://hub.docker.com/r/georgx22/mcp-office-docs/tags) – pin a version tag once you tested it
OFFICE_MCP_TAG=latest
# Python for kira-files (https://hub.docker.com/_/python/tags)
PYTHON_TAG=3.13-alpine
# KIRA_DOMAIN is set by setup.sh (uploads go to https://<KIRA_DOMAIN>, i.e. to Caddy)
