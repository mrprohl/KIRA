# Documents for KIRA agents – versions (copied to env/versions.env by setup.sh; change here, then run setup.sh)
# Login service for the downloads: github.com/oauth2-proxy/oauth2-proxy/releases
OAUTH2_PROXY_TAG=v7.15.6
# Base image of the document services (Python, Tesseract) – setup.sh builds kira/docs:<hash> from /opt/docs/app
PYTHON_IMAGE=python:3.13-slim-bookworm
# DOCS_IMAGE is set by setup.sh
